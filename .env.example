# ---------- Discord ----------
# Developer Portal > ton application > Bot > Reset Token
DISCORD_TOKEN=
# Clic droit (mode développeur activé) > Copier l'identifiant
GUILD_ID=
# Salon vocal « -radio »
VOICE_CHANNEL_ID=
# Salon texte où le bot épingle l'aide et annonce les titres
TEXT_CHANNEL_ID=
# Rôle DJ (commandes /pause /play /next /playlist /mode ...)
DJ_ROLE_ID=
# Ton compte perso : reçoit les notifications de demandes en MP
OWNER_ID=
# Compte « RADIO CREEP » : exclu du décompte des auditeurs pour /skip
RADIO_ACCOUNT_ID=
# Optionnel : salon privé DJ où poster les demandes à valider (sinon MP seulement)
DJ_CHANNEL_ID=

# ---------- Jukebox ----------
# auto    : le bot ajoute la demande à la file Apple Music tout seul (repli manuel si échec)
# approve : un DJ clique « Ajouter » puis le bot l'ajoute à la file Apple Music
# manual  : un DJ l'ajoute lui-même dans Apple Music puis clique « C'est fait »
REQUEST_MODE=approve
MAX_PENDING_PER_USER=2
MAX_QUEUE=25
# Afficher la file réelle d'Apple Music dans /queue (ouvre le panneau « File » de l'appli ;
# si la fenêtre Apple Music est RÉDUITE, cela lui donne le focus ~1 s : voir README)
SHOW_APPLE_QUEUE=false
# Avant d'agir automatiquement dans Apple Music, attendre que clavier et souris
# n'aient pas bougé depuis N secondes (0 = ne pas attendre).
# Ne concerne pas les demandes et les recherches : elles passent toujours tout de suite.
UI_IDLE_SECONDS=5
# Supprimer l'annonce précédente à chaque nouveau titre (garde le salon propre)
ANNOUNCE_DELETE_PREVIOUS=false

# ---------- Bibliothèque ----------
# Source 1 (prioritaire si le fichier existe) : export XML d'Apple Music / iTunes
LIBRARY_XML=
# Source 2 : dossiers de fichiers audio, séparés par ;
LIBRARY_DIRS=E:\Music\iTunes\iTunes Media\Music

# ---------- Catalogue Apple Music complet ----------
# /search, /request et l'autocomplétion cherchent aussi dans tout le catalogue Apple Music
# (API publique d'Apple, gratuite, sans clé). false = seulement tes fichiers et ta bibliothèque.
CATALOG=true
# Pays du catalogue (celui de ton compte Apple Music) : fr, be, ch, ca, us…
CATALOG_COUNTRY=fr

# ---------- Diffusion par le bot (facultatif, voir /diffusion) ----------
# Salon vocal où le bot diffuse lui-même dès le démarrage (vide = non). /diffusion prime sur ce réglage.
STREAM_CHANNEL_ID=
# Périphérique d'enregistrement capté (nom ou partie du nom) et débit en kbps (max 512)
STREAM_DEVICE=Voicemeeter Out B2
STREAM_BITRATE=256

# ---------- Station automatique ----------
# Quand la file Apple Music est vide, lancer une station dans le style du dernier morceau
# (« Create Station »). /station auto permet de changer d'avis sans redémarrer.
AUTO_STATION=true
